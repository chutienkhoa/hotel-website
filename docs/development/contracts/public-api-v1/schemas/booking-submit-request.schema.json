{
  "type": "object",
  "properties": {
    "quoteId": {
      "$ref": "https://schemas.hotel.invalid/pms/public/v1/common.schema.json#/$defs/uuid"
    },
    "checkInDate": {
      "$ref": "https://schemas.hotel.invalid/pms/public/v1/common.schema.json#/$defs/date"
    },
    "checkOutDate": {
      "$ref": "https://schemas.hotel.invalid/pms/public/v1/common.schema.json#/$defs/date"
    },
    "adults": {
      "type": "integer",
      "minimum": 1
    },
    "children": {
      "type": "integer",
      "minimum": 0
    },
    "bookingMode": {
      "$ref": "https://schemas.hotel.invalid/pms/public/v1/common.schema.json#/$defs/bookingMode"
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.hotel.invalid/pms/public/v1/common.schema.json#/$defs/basketLine"
      }
    },
    "acceptedCancellationPolicyRevision": {
      "type": "integer",
      "minimum": 1
    },
    "guest": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "fullName",
        "email",
        "phone"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "quoteId",
    "checkInDate",
    "checkOutDate",
    "adults",
    "children",
    "bookingMode",
    "rooms",
    "acceptedCancellationPolicyRevision",
    "guest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hotel.invalid/pms/public/v1/booking-submit-request.schema.json",
  "title": "booking-submit-request"
}
